APP_NAME=Gatezo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=gatezo
DB_USERNAME=gatezo
DB_PASSWORD=gatezo

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public demo: /demo signs visitors into the seeded demo event (php artisan db:seed --class=DemoSeeder)
GATEZO_WHATSAPP=919328964742
# GATEZO_SIGNUP_NOTIFY=you@example.com   # mail a one-liner here for every self-serve sign-up
GATEZO_DEMO=false
GATEZO_DEMO_RESET_AT=04:00

# Docker production (compose.prod.yml): domain for Caddy's certificate, MySQL root password,
# trust the proxy so links are https, log to the container's stderr.
# GATEZO_DOMAIN=gatezo.in
# DB_ROOT_PASSWORD=change-me
# TRUSTED_PROXIES=*
# LOG_CHANNEL=stderr
# GATEZO_DEMO_SEED_ON_BOOT=true   # seed the demo event on first start (rerun is harmless)
